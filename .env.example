# Browser configuration (public; bundled by Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
VITE_APP_MODE=production
VITE_DEMO_MODE=false
VITE_DEFAULT_TENANT_SLUG=luxe-hair-studio

# Application origin
APP_URL=https://loyalty.example.com

# Supabase server credentials (server only)
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Authentication and signing (server only; use independent 32+ byte random values)
STAFF_SESSION_SECRET=replace_with_a_random_value_of_at_least_32_bytes
QR_SIGNING_SECRET=replace_with_a_different_random_value_of_at_least_32_bytes
CRON_SECRET=replace_with_another_random_value_of_at_least_32_bytes

# Google Wallet issuer and service account (server only)
GOOGLE_WALLET_ISSUER_ID=your_numeric_issuer_id
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet-issuer@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY=your_google_service_account_private_key_pem_with_escaped_newlines
# Optional overrides; defaults are derived from APP_URL and issuer configuration.
GOOGLE_WALLET_CLASS_SUFFIX=loyalty
GOOGLE_WALLET_ORIGINS=https://loyalty.example.com

# Supabase Auth SMS provider setup (normally entered in the Supabase dashboard)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Server-side Turnstile verification for the OTP proxy
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Local migration tooling only; do not add this value to the Vercel application
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_password@your_pooler_host:5432/postgres
