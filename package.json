{
  "name": "atelier-loyalty",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test": "npm run test:unit && npm run test:e2e && npm run test:e2e:production",
    "check": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@zxing/browser": "^0.1.5",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tsx": {
      "esbuild": "^0.28.1"
    }
  }
}
